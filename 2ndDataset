--=====5.	Generate an alphabetically ordered comma separated ingredient list for each pizza order from the customer_orders table and add a 2x in front of any relevant ingredients
--====o	For example: "Meat Lovers: 2xBacon, Beef, ... , Salami"

SELECT
    x.order_id,
    pn.pizza_name + ': ' +
    STRING_AGG(
        CASE
            WHEN x.ingredient_count = 2
                THEN '2x' + x.topping_name
            ELSE x.topping_name
        END,
        ', '
    ) WITHIN GROUP (ORDER BY x.topping_name) AS ingredient_list

FROM
(
    -- Standard ingredients, excluding customer exclusions
    SELECT
        co.order_id,
        co.pizza_id,
        pt.topping_id,
        pt.topping_name,
        1 AS ingredient_count
    FROM customer_orders co

    JOIN pizza_recipes pr
        ON co.pizza_id = pr.pizza_id

    CROSS APPLY STRING_SPLIT(pr.toppings, ',') s

    JOIN pizza_toppings pt
        ON TRY_CAST(TRIM(s.value) AS INT) = pt.topping_id

    WHERE NOT EXISTS
    (
        SELECT 1
        FROM STRING_SPLIT(co.exclusions, ',') e
        WHERE TRY_CAST(TRIM(e.value) AS INT) = pt.topping_id
    )

    UNION ALL

    -- Customer extras
    SELECT
        co.order_id,
        co.pizza_id,
        pt.topping_id,
        pt.topping_name,
        1 AS ingredient_count
    FROM customer_orders co

    CROSS APPLY STRING_SPLIT(co.extras, ',') s

    JOIN pizza_toppings pt
        ON TRY_CAST(TRIM(s.value) AS INT) = pt.topping_id
) x

JOIN pizza_names pn
    ON x.pizza_id = pn.pizza_id

GROUP BY
    x.order_id,
    x.pizza_id,
    pn.pizza_name;

