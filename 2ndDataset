--====C. Ingredient Optimisation
--======1.What are the standard ingredients for each pizza?-======
SELECT
       pr.pizza_id,
       s.value AS topping_id,
       pt.topping_name
FROM pizza_recipes pr
CROSS APPLY STRING_SPLIT(pr.toppings, ',') s
JOIN pizza_toppings pt
      ON CAST(s.value AS INT) = pt.topping_id;

--======2.	What was the most commonly added extra?-====

SELECT TOP 1 WITH TIES
      pt.topping_name,
      COUNT(*) AS extra_count
FROM customer_orders co
CROSS APPLY STRING_SPLIT(co.extras, ',') s
JOIN pizza_toppings pt
     ON TRY_CAST(TRIM(s.value) AS INT) = pt.topping_id
GROUP BY
     pt.topping_id,
     pt.topping_name
ORDER BY
     COUNT(*) DESC;

--=====3.What was the most common exclusion?
SELECT TOP 1 WITH TIES
      pt.topping_name,
      COUNT(*) AS exclusion_count
FROM customer_orders co
CROSS APPLY STRING_SPLIT(co.exclusions, ',') s
JOIN pizza_toppings pt
     ON TRY_CAST(TRIM(s.value) AS INT) = pt.topping_id
GROUP BY
     pt.topping_id,
     pt.topping_name
ORDER BY
     COUNT(*) DESC;

