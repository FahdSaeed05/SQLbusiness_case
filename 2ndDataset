--===o	Meat Lovers - Exclude Cheese, Bacon - Extra Mushroom, Peppers


SELECT
    Co.Order_id,
    co.customer_id,
    co.pizza_id,
    
    pn.Pizza_name
    +
    CASE
        WHEN ex.exclusion_names IS NOT NULL
        then ' - Exclude ' + ex.exclusion_names
        ELSE ''
    END 
    +
    CASE    
        WHEN et.extra_names IS NOT NULL
        THEN ' - Extra ' + et.extra_names
        ELSE ''
    END AS order_item

FROM customer_orders co
   

