--====2.What if there was an additional $1 charge for any pizza extras? o	Add cheese is $1 extra

WITH Pizza_revenue AS 
(
SELECT
     co.order_id,
     co.pizza_id,
        CASE
             WHEN co.pizza_id = 1 THEN 12
             WHEN co.pizza_id = 2 THEN 10    
        ENd AS Pizza_price,
        
        CASE
            WHEN EXISTS (
                SELECT 1
                FROM STRING_SPLIT(co.extras, ',') s
                WHERE TRIM(s.value) = '1'
        
        ) 
            THEN 1
            ELSE 0
         END AS Extra_charge
    
    FROM Customer_Orders co
    JOIN Runner_Orders ro
ON co.Order_id = ro.Order_ID
    WHERE ro.Cancellation IS NULL
    )

    SELECT
         SUM(pizza_price + extra_charge) AS Total_revenue
    FROM Pizza_revenue

