),

Balance_duration AS 
(
	SELECT
		customer_id,
		txn_date,
		end_of_month,
		Txn_month,
		month_name,
		txn_year,
		running_balance,

		ISNULL(
				LEAD(txn_date) OVER(PARTITION BY customer_id ORDER BY txn_date), end_of_month
		) AS next_transaction_date,
		
		DATEDIFF(day, txn_date, 
		ISNULL(
				LEAD(txn_date) OVER(PARTITION BY customer_id ORDER BY txn_date), end_of_month))
		+ 1 AS Days_held
		FROM running_balances
		)

	SELECT
		Customer_id,
		txn_month,
		month_name,
		txn_year,
		--If running balance is negative, equal it to 0
		SUM(IIF(running_balance > 0,running_balance, 0)) AS base_data_allocated,

		--bonus interest reward
		SUM(IIF(running_balance > 0,running_balance, 0) * (0.06/365) * days_held) AS interest_data_reward,

		--Total provision: base + reward

		CAST(SUM(IIF(running_balance > 0,running_balance, 0) * (1.0 + 0.06/365) * days_held) AS INT)
		AS total_data_required
	FROM balance_duration
	GROUP BY customer_id, txn_month, month_name, txn_year
	ORDER BY customer_id, txn_month, month_name, txn_year

