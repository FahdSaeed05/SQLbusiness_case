--3. Product Funnel Analysis
---Using a single SQL query - create a new output table which has the following details:

--a)How many times was each product viewed?

WITH product_views AS (
SELECT 
	ph.product_id,
	ph.product_category,
	ph.page_name AS product_name,
	COUNT(*) AS view_count
FROM events e
JOIN page_hierarchy ph
	ON e.page_id = ph.page_id
WHERE e.event_type = 1
AND product_id IS NOT NULL
GROUP BY ph.product_id, ph.product_category, ph.page_name
),

--b)How many times was each product WAS added to cart?

Product_cart_adds AS (
SELECT 
	
	ph.product_id,
	COUNT(*) AS added_to_cart_count	
FROM events e
JOIN page_hierarchy ph
	ON e.page_id = ph.page_id
WHERE e.event_type = 2
AND ph.product_id IS NOT NULL
GROUP BY ph.product_id
),

--c)How many times was each product added to a cart but not purchased (abandoned)?
Purchased_visits AS (
	SELECT DISTINCT visit_id
	FROM events
	WHERE event_type = 3
),

--d)How many times was each product purchased?
	Product_purchases AS (
	SELECT
		ph.product_id,
		COUNT(*) AS purchase_count
	FROM events e
	JOIN page_hierarchy ph
		ON e.page_id = ph.page_id
	JOIN Purchased_visits pv 
	ON e.visit_id = pv.visit_id
	WHERE e.event_type = 2 -- Added to cart in a session that purchased
	GROUP BY ph.product_id
)

--Final Select: JOIN ALL CTES/Metric tables together and save into a new table
SELECT
	v.product_id,
	v.product_category,
	V.product_name,
	v.view_count,
	ISNULL(c.added_to_cart_count, 0) AS added_cart_count,
	-- Abandoned = (Total Cart Adds) - (Successful Purchases)
	ISNULL(c.added_to_cart_count, 0) - ISNULL(p.purchase_count, 0) AS abandoned_count,
	ISNULL(p.purchase_count, 0) AS purcHase_count
INTO product_funnel_summary -- creates the single output table
FROM product_views v
LEFT JOIN product_cart_adds c ON v.product_id = c.product_id
LEFT JOIN Product_purchases p ON v.product_id = p.product_id;

