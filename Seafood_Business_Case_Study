--a) Identifying users who have received impressions during each campaign period and comparing each metric with other users who did not have an impression event

WITH user_campaign_classification AS (

SELECT
	User_id,
	visit_id,
	campaign_name,

	CASE
		WHEN sum(impression) > 0 THEN 'Received Impression'
		ELSE 'No Impression'

	END AS impression_group,

--Aggregated their total behaviour mertrics across this specific campaign

	SUM(page_views) AS total_views,
	SUM(cart_adds) AS total_cart_adds,
	SUM(purchase) AS total_purchases
FROM campaign_analysis_summary
WHERE campaign_name <> 'Organic Traffic'  --- Strictly look at active campaign windows
GROUP BY user_id, campaign_name, visit_id
)

SELECT
	campaign_name,
	impression_group,
	COUNT(DISTINCT user_id) AS total_users,
	COUNT(DISTINCT visit_id) AS total_users,
	ROUND(AVG(total_views * 1.0), 2) AS avg_page_views,
	ROUND(AVG(total_cart_adds * 1.0), 2) avg_cart_adds,
	ROUND(AVG(total_purchases * 1.0), 2) avg_purchases,
	SUM(total_purchases) AS total_successful_purchases,
	-- Replace your current purchases_conversion_rate formula with this:
	ROUND(100.0 * SUM(total_purchases) / COUNT(DISTINCT visit_id), 2) AS purchase_conversion_rate

FROM user_campaign_classification
GROUP BY campaign_name, impression_group
ORDER BY campaign_name, impression_group DESC




