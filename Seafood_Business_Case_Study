--3.What is the unique number of visits by all users per month?

WITH Joined_tables AS (

SELECT
	e.visit_id,
	u.user_id,
	e.event_time

FROM events e
JOIN users u
ON e.cookie_id = u.cookie_id
)

SELECT
		
		DATENAME(MONTH, event_time) AS [month_name],
		COUNT(DISTINCT visit_id) AS unique_visit_no


FROM joined_tables
GROUP BY DATENAME(MONTH, event_time), MONTH(event_time)
ORDER BY MONTH(event_time)
	

--4.What is the number of events for each event type?

SELECT
	e.event_type,
	i.event_name,
	COUNT(e.event_type) AS event_count
FROM events e
	JOIN event_identifier i
	ON e.event_type = i.event_type
GROUP BY e.event_type, i.event_name
ORDER BY event_count DESC

--5.What is the percentage of visits which have a purchase event?
SELECT
	COUNT(DISTINCT CASE WHEN event_type = 3 THEN visit_id END) AS purchase_visits,
	COUNT(DISTINCT visit_id) AS total_visits,
	ROUND(
	100* COUNT(DISTINCT CASE WHEN event_type = 3 THEN visit_id END) / COUNT(DISTINCT visit_id), 
	2)
	AS visit_percentage
FROM events

--6.What is the percentage of visits which view the checkout page but do not have a purchase event?

SELECT 
	--1. Total Unique visits that reached the checkout page
	COUNT(DISTINCT CASE WHEN page_id = 12 THEN visit_id END ) AS checkout_page_vists,
	
	--2. Total unique visits minus visits with purchase events
	COUNT(DISTINCT CASE WHEN page_id = 12 THEN visit_id END) -
	COUNT(DISTINCT CASE WHEN event_type = 3 THEN visit_id END) AS checkout_without_purchase,

	--3.Percentage of check-out vists that didnt include a purchase event

ROUND(
		100 * (COUNT(DISTINCT CASE WHEN page_id = 12 THEN visit_id END) -
		COUNT(DISTINCT CASE WHEN event_type = 3 THEN visit_id END)) /
		COUNT(DISTINCT CASE WHEN page_id = 12 THEN visit_id END), 
		2) AS chekout_without_purchase_pcnt
FROM events


