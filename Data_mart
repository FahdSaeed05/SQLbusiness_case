--1.What is the total sales for the 4 weeks before and after 2020-06-15? What is the growth or reduction rate in actual values and percentage of sales?

WITH Categorized_Sales AS
(
    SELECT
        Sales,
        
        CASE
            WHEN Week_number BETWEEN 21 AND 24 THEN 'Before'
            WHEN week_number BETWEEN 25 AND 28 THEN 'After'
            ELSE 'Outside Window'
        END AS time_period
    FROM clean_weekly_sales
    WHERE calendar_year = '2020'
   )
   SELECT--1. Total_Sales for both periods
        SUM(CASE WHEN time_period IN ('Before', 'After') THEN sales ELSE 0 END) AS total_sales,
        --2. Total_Sales for indivdual periods
        SUM(CASE WHEN time_period = 'Before' THEN sales ELSE 0 END) AS before_sales,
        SUM(CASE WHEN time_period = 'After' THEN sales ELSE 0 END) AS after_sales,

       --2 Growth or reduction rate in actual rates
       SUM(CASE WHEN time_period = 'After' THEN Sales ELSE 0 END) -
       SUM(CASE WHEN time_period = 'Before' THEN Sales ELSE 0 END) AS actual_variance,
       
       --Growth or reduction rate in percentage
       ROUND(
          100 * (SUM(CASE WHEN time_period = 'After' THEN sales ELSE 0 END) -
                SUM(CASE WHEN time_period = 'Before' THEN sales ELSE 0 END)) /
          NULLIF(SUM(CASE WHEN time_period = 'Before' THEN sales ELSE 0 END), 0),
          2) AS percentage_variance
    FROM categorized_sales
    WHERE time_period IN ('Before', 'After');


