--===1.How many customers has Foodie-Fi ever had?

SELECT 
	COUNT(DISTINCT customer_id) AS Total_Customers
FROM foodie_fi.subscriptions

--====2.What is the monthly distribution of trial plan start_date values for our dataset - use the start of the month as the group by value
select
	COUNT(*) AS trial_starts,
	DATETRUNC(MONTH, start_date) AS month_start
FROM foodie_fi.subscriptions
WHERE plan_id = 0
GROUP BY DATETRUNC(MONTH, start_date)
Order BY month_start 

--=====3. What plan start_date values occur after the year 2020 for our dataset? Show the breakdown by count of events for each plan_name

WITH Subscriptions_plans AS
(SELECT
	 fp.plan_name,
	 DATENAME(YEAR, fs.start_date) AS Start_year,
	 fs.plan_id

FROM foodie_fi.plans fp
JOIN foodie_fi.subscriptions fs
	ON fp.plan_id = fs.plan_id
	)

SELECT
	plan_name,
	COUNT(*) AS total_events,
	start_year
	
FROM Subscriptions_plans
WHERE start_year > 2020
GROUP BY plan_name, start_year


