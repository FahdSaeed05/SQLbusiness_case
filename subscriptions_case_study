--==Step1: Track when the Next plan starts and calculate the end of 2020 boundary
-- 1. Create the physical target table
CREATE TABLE payments_2020 (
    payment_id     INT IDENTITY(1,1) PRIMARY KEY,
    customer_id    INT NOT NULL,
    plan_id        INT NOT NULL,
    plan_name      VARCHAR(50) NOT NULL,
    payment_date   DATE NOT NULL,
    amount         DECIMAL(10,2) NOT NULL,
    payment_order  INT NOT NULL
);





-- 2. Build the Common Table Expressions (CTEs) to isolate and loop dates

WITH lead_subs AS (

SELECT 
	s.customer_id,
	s.plan_id,
	p.plan_name,
	s.start_date,
	p.price,
	LEAD(s.start_date) OVER(PARTITION BY s.customer_id ORDER BY start_date) AS next_date
FROM Foodie_fi.subscriptions s
JOIN Foodie_fi.plans p
	ON s.plan_id = p.plan_id
WHERE s.start_date <= '2020-12-31'
),

Payment_dates AS (
SELECT
	customer_id,
	plan_id,
	plan_name,
	start_date AS payment_date,

	CASE
		WHEN next_date IS NULL THEN '2020-12-31'
		WHEN next_date >  '2020-12-31' THEN '2020-12-31'
		ELSE DATEADD(DAY, -1, next_date)
	END AS last_payment_date,
	price AS amount
FROM lead_subs
WHERE plan_id != 0 AND plan_id != 4

UNION ALL

SELECT
	customer_id,
	plan_id,
	plan_name,

	CASE
		WHEN plan_id IN (1,2) THEN DATEADD(MONTH, 1, payment_date)
		WHEN plan_id = 3 THEN DATEADD(YEAR, 1, payment_date)
	END AS payment_date,
	last_payment_date,
	amount
FROM payment_dates

-- Recursion condition:Keep running until the next cycle surpasses the cutoff or the end of 2020
WHERE (plan_id IN (1,2) AND DATEADD(MONTH, 1, payment_date) <= last_payment_date)
	OR (plan_id = 3 AND DATEADD(YEAR, 1, payment_date) <= last_payment_date)
	),
	prorated_adjustments AS (

	--Step4: Handle mid-month upgrade discounts (e.g, upgrading from basic to pro)

	SELECT
		customer_id,
		plan_id,
		plan_name,
		payment_date,

		CASE
			WHEN plan_id = 2 AND LAG(plan_id) OVER(PARTITION BY customer_id ORDER BY payment_date) = 1
				AND DATEDIFF(DAY, LAG(payment_date) OVER(PARTITION BY customer_id ORDER BY payment_date), payment_date) <= 30
			THEN amount - 9.90 -- Subtract the $9.90 basic monthly payment from the $19.90 pro plan
			ELSE amount
		END AS amount
	FROM payment_dates
)

-- Step 5: Insert into the target table while generating sequential order numbers
INSERT INTO payments_2020 (customer_id, plan_id, plan_name, payment_date, amount, payment_order)

SELECT
	customer_id, 
	plan_id, 
	plan_name, 
	payment_date,
	amount, 
	ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY payment_date) AS payment_order
FROM prorated_adjustments
ORDER BY customer_id, payment_date;



SELECT * FROM payments_2020

--1.	How would you calculate the rate of growth for Foodie-Fi?

WITH Monthly_Revenue AS
(

	SELECT
		Month(payment_date) AS payment_month,
		DATENAME(Month, payment_date) AS month_name,
		SUM(Amount) AS Revenue
	FROM payments_2020
	GROUP BY Month(payment_date),
			DATENAME(Month, payment_date)
	)

SELECT
	month_name,
	revenue,
	LAG(revenue) OVER(ORDER BY payment_month) AS previous_month_revenue,
	(revenue - LAG(revenue) OVER(ORDER BY payment_month)) /
	LAG(revenue) OVER(ORDER BY payment_month) * 100 AS growth_rate
FROM monthly_revenue
ORDER BY payment_month


