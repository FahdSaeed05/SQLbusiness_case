

--High Level Sales Analysis
--1)What was the total quantity sold for all products?
SELECT
	SUM(qty) AS total_quantity_sold,
	Prod_id
FROM sales
GROUP BY Prod_id
ORDER BY total_quantity_sold DESC


--2)What is the total generated revenue for all products before discounts?

SELECT
SUM(qty * price) AS revenue_before_discount

FROM sales



--3)What was the total discount amount for all products?
SELECT
SUM(discount) AS total_discount

FROM Sales

--Transaction Analysis
--1) How many unique transactions were there?

SELECT 
	COUNT (DISTINCT txn_id) AS unique_transactions
FROM sales

--2) What is the average unique products purchased in each transaction?

WITH unique_prod_id AS (
SELECT
	COUNT(DISTINCT prod_id) AS unique_prod,
	TXN_ID

FROM sALES
GROUP BY txn_id
)
SELECT
	AVG(unique_prod) AS avg_unique_prod
FROM unique_prod_id

--3) What are the 25th, 50th and 75th percentile values for the revenue per transaction?

WITH transaction_revenue AS (
	SELECT
		txn_id,
		SUM(qty * price) AS total_txn_revenue
	
	FROM Sales
	GROUP BY txn_id
	)

SELECT DISTINCT
	Percentile_cont(0.25) WITHIN GROUP (ORDER BY total_txn_revenue) OVER() AS percentile_25,
	Percentile_cont(0.50) WITHIN GROUP(ORDER BY total_txn_revenue) OVER() AS percentile_50_median,
	Percentile_cont(0.75) WITHIN GROUP(ORDER BY total_txn_revenue) OVER() AS percentile_75
FROM Transaction_revenue;

--4) What is the average discount value per transaction?

WITH transaction_discount AS (
	SELECT
		txn_id,
		AVG(discount * 1.0) AS Avg_discount_percentage
	FROM Sales
	GROUP BY txn_id
)

SELECT 
	ROUND(AVG(avg_discount_percentage), 2) AS avg_discount_per_transaction
FROM transaction_discount

--5) What is the percentage split of all transactions for members vs non-members?
WITH buyer_category AS (

SELECT
	COUNT(DISTINCT txn_id) AS total_transactions,
	CASE 
		WHEN member = 't' THEN 'Member' ELSE 'Non-Member' END AS member_categorization
FROM sales
GROUP BY member
)

	SELECT
		member_categorization,
		total_transactions,
	
		ROUND(total_transactions * 100 / SUM(total_transactions) OVER(),
		2) AS transaction_percentage
	FROM buyer_category


--6) What is the average revenue for member transactions and non-member transactions?


WITH transaction_revenue AS (

SELECT
	txn_id,
	member,
	SUM(qty * price) AS total_revenue
FROM Sales
GROUP BY txn_id, member
)

SELECT
	
	CASE 
		WHEN member = 't' THEN 'Member' ELSE 'Non-Member' END AS member_categorization,
	ROUND(AVG(CAST(total_revenue AS DECIMAL(8, 2))), 2) AS avg_revenue
FROM transaction_revenue
GROUP BY member

--Product Analysis
--1. What are the top 3 products by total revenue before discount?
SELECT TOP 3
prod_id,
SUM(qty * price) AS total_revenue

FROM Sales
GROUP BY prod_id
ORDER BY total_revenue DESC

--What is the total quantity, revenue and discount for each segment?
SELECT
	SUM(s.qty) AS total_quantity,
	SUM(s.qty * s.price) AS total_revenue,
	SUM(s.discount) AS total_discount,
	pd.segment_name AS segment

FROM Sales s
JOIN Product_details pd
	ON s.prod_id = pd.prod_id
GROUP BY pd.segment_name


--What is the top selling product for each segment?

WITH Sales_qty_rank AS (
SELECT
	SUM(s.qty) AS total_quantity,
	pd.segment_name,
	pd.Product_name,

	Rank() OVER(PARTITION BY pd.segment_name ORDER BY SUM(s.qty) DESC) AS sales_rank

FROM Sales s
JOIN Product_details pd
	ON s.prod_id = pd.prod_id
GROUP BY pd.product_name, pd.segment_name
)

SELECT
	segment_name,
	product_name,
	total_quantity
FROM Sales_qty_rank
WHERE sales_rank =1
ORDER BY segment_name


--What is the total quantity, revenue and discount for each category?

SELECT
	SUM(s.qty) AS total_quantity,
	SUM(s.qty * s.price) AS total_revenue,
	SUM(s.discount) AS total_disocunt,
	pd.category_name

FROM Sales s
JOIN product_details pd
	ON s.prod_id = pd.prod_id
GROUP BY pd.category_name


--What is the top selling product for each category?

WITH Ranking_Product_Sales AS (

SELECT
	SUM(s.qty) AS sold_quantity,
	pd.product_name,
	pd.category_name,
	RANK() OVER(PARTITION BY category_name ORDER BY SUM(s.qty) DESC) AS Sales_rank
FROM Sales s
	JOIN Product_details pd
ON s.prod_id = pd.prod_id
GROUP BY pd.product_name, pd.category_name
)

SELECT
	product_name,
	category_name,
	sold_quantity
FROM Ranking_product_Sales
WHERE Sales_rank = 1

--What is the percentage split of revenue by product for each segment?
WITH Total_Segment_Revenue AS (
SELECT
	SUM(s.qty * s.price) AS total_revenue,
	pd.segment_name,
	pd.product_name

FROM Sales s
JOIN Product_details pd
 ON s.prod_id = pd.prod_id
GROUP BY pd.segment_name, pd.product_name
)
SELECT
	segment_name,
	product_name,
	ROUND( 100.0 * Total_revenue / SUM(Total_revenue) OVER(PARTITION BY segment_name), 2) AS revenue_split_percentage
FROM Total_Segment_Revenue

--What is the percentage split of revenue by segment for each category?

WITH Category_revenue AS (
SELECT
	SUM(s.qty * s.price) AS Total_revenue,
	pd.segment_name,
	pd.category_name
FROM Sales s
JOIN Product_details pd
	ON s.prod_id = pd.prod_id
GROUP BY pd.segment_name, pd.category_name
)

SELECT
	segment_name,
	category_name,
	ROUND( 100.0 * Total_revenue / SUM(total_revenue) OVER(PARTITION BY Category_name), 2) AS category_revenue_split_percentage
FROM Category_revenue

--What is the percentage split of total revenue by category?

WITH Total_overall_revenue AS (

SELECT
	SUM(s.qty * s.price) AS total_revenue,
	pd.category_name
FROM Sales s
JOIN product_details pd
	ON s.prod_id = pd.prod_id
GROUP BY pd.category_name
)

SELECT
	Category_name,
	ROUND( 100.0 * Total_revenue / SUM(total_revenue) OVER(), 2) AS category_revenue_percentage
FROM Total_Overall_revenue

--What is the total transaction “penetration” for each product? (hint: penetration = number of transactions where at least 1 quantity of a product was purchased divided by total number of transactions)

WITH Product_txn_count AS (
	SELECT
		prod_id,
		COUNT(DISTINCT txn_id) AS Product_Transactions
	FROM Sales
	GROUP BY prod_id 

)

SELECT
	p.prod_id,
	pd.product_name,
	p.product_transactions,
ROUND( 100 * p.Product_transactions / (SELECT COUNT(DISTINCT txn_id) FROM Sales), 2) AS penetration_percentage
FROM product_txn_count p
JOIN Product_details pd
	ON p.prod_id = pd.prod_id
ORDER BY penetration_percentage DESC

--What is the most common combination of at least 1 quantity of any 3 products in a 1 single transaction?
SELECT
	p1.product_name AS product_1,
	p2.product_name AS product_2,
	p3.product_name AS product_3,
	COUNT(*) AS common_transaction_count
	
FROM Sales s1
JOIN Sales s2
	ON s1.txn_id = s2.txn_id 
	AND s1.prod_id < s2.prod_id
JOIN sales s3 
	ON s1.txn_id = s3.txn_id 
	AND s2.prod_id < s3.prod_id

LEFT JOIN product_details p1 ON s1.prod_id = p1.prod_id
LEFT JOIN product_details p2 ON s2.prod_id = p2.prod_id
LEFT JOIN product_details p3 ON s3.prod_id = p3.prod_id


GROUP BY p1.product_name, p2.product_name, p3.product_name
ORDER BY common_transaction_count DESC;

