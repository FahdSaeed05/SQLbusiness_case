-- =================================================================================
-- TABLE 1: HIGH LEVEL SALES ANALYSIS (Questions 1, 2, 3)
-- =================================================================================
SELECT
    DATENAME(MONTH, start_txn_time) AS reporting_month,
    MONTH(start_txn_time) AS month_sort_key, 
    SUM(qty) AS total_quantity_sold,
    SUM(qty * price) AS gross_revenue_before_discount,
    ROUND(SUM(qty * price * (discount / 100.0)), 2) AS total_discount_dollars
INTO report_high_level_sales
FROM sales
GROUP BY DATENAME(MONTH, start_txn_time), MONTH(start_txn_time);

-- =================================================================================
-- TABLE 2: TRANSACTION ANALYSIS - PERCENTILES (Question 3 & 4)
-- =================================================================================
WITH transaction_revenue AS (
    SELECT 
        DATENAME(MONTH, start_txn_time) AS reporting_month,
        MONTH(start_txn_time) AS month_sort_key,
        txn_id, 
        SUM(qty * price) AS total_txn_revenue
    FROM sales
    GROUP BY DATENAME(MONTH, start_txn_time), MONTH(start_txn_time), txn_id
)             
SELECT DISTINCT
    reporting_month,
    month_sort_key,
    PERCENTILE_CONT(0.25) WITHIN GROUP (ORDER BY total_txn_revenue) OVER(PARTITION BY month_sort_key) AS percentile_25,
    PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY total_txn_revenue) OVER(PARTITION BY month_sort_key) AS percentile_50_median,
    PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY total_txn_revenue) OVER(PARTITION BY month_sort_key) AS percentile_75
INTO report_transaction_percentiles
FROM transaction_revenue;

-- =================================================================================
-- TABLE 3: TRANSACTION ANALYSIS - SHOPS BY MEMBER TYPE (Question 5 & 6)
-- =================================================================================
WITH buyer_category AS (
    SELECT
        DATENAME(MONTH, start_txn_time) AS reporting_month,
        MONTH(start_txn_time) AS month_sort_key, 
        CASE WHEN member = 't' THEN 'Member' ELSE 'Non-Member' END AS member_categorization,
        COUNT(DISTINCT txn_id) AS total_transactions,
        SUM(qty * price) AS total_revenue
    FROM sales
    GROUP BY DATENAME(MONTH, start_txn_time), MONTH(start_txn_time), CASE WHEN member = 't' THEN 'Member' ELSE 'Non-Member' END
)
SELECT
    reporting_month,
    month_sort_key,
    member_categorization,
    total_transactions,
    ROUND(100.0 * total_transactions / SUM(total_transactions) OVER(PARTITION BY month_sort_key), 2) AS transaction_percentage_split,
    ROUND(total_revenue / total_transactions, 2) AS avg_revenue_per_transaction
INTO report_member_splits
FROM buyer_category;

-- =================================================================================
-- TABLE 4: PRODUCT PERFORMANCE DETAILS (Questions 1, 2, 4, 9)
-- =================================================================================
WITH global_monthly_txns AS (
    SELECT 
        MONTH(start_txn_time) AS r_month_key,
        COUNT(DISTINCT txn_id) AS monthly_total_txns
    FROM sales
    GROUP BY MONTH(start_txn_time)
)
SELECT
    DATENAME(MONTH, s.start_txn_time) AS reporting_month,
    MONTH(s.start_txn_time) AS month_sort_key, 
    pd.product_name,
    pd.segment_name,
    pd.category_name,
    SUM(s.qty) AS total_quantity_sold,
    SUM(s.qty * s.price) AS total_gross_revenue,
    ROUND(SUM(s.qty * s.price * (s.discount / 100.0)), 2) AS total_discount_dollars,
    ROUND(100.0 * COUNT(DISTINCT s.txn_id) / MAX(g.monthly_total_txns), 2) AS penetration_percentage
INTO report_product_performance_summary
FROM sales s
JOIN product_details pd ON s.prod_id = pd.prod_id
JOIN global_monthly_txns g ON MONTH(s.start_txn_time) = g.r_month_key
GROUP BY DATENAME(MONTH, s.start_txn_time), MONTH(s.start_txn_time), pd.product_name, pd.segment_name, pd.category_name;

-- =================================================================================
-- TABLE 5: REVENUE SPLIT PERCENTAGE BY CATEGORY (Question 6, 7, 8)
-- =================================================================================
WITH total_overall_revenue AS (
    SELECT
        DATENAME(MONTH, s.start_txn_time) AS reporting_month,
        MONTH(s.start_txn_time) AS month_sort_key, 
        pd.category_name,
        SUM(s.qty * s.price) AS total_revenue
    FROM sales s
    JOIN product_details pd ON s.prod_id = pd.prod_id
    GROUP BY DATENAME(MONTH, s.start_txn_time), MONTH(s.start_txn_time), pd.category_name
)
SELECT
    reporting_month,
    month_sort_key,
    category_name,
    total_revenue,
    ROUND(100.0 * total_revenue / SUM(total_revenue) OVER(PARTITION BY month_sort_key), 2) AS category_revenue_percentage
INTO report_revenue_splits_by_category
FROM total_overall_revenue;

-- =================================================================================
-- TABLE 6: STRONGEST 3-PRODUCT COMBINATION TRIPLET PER MONTH 
-- =================================================================================
WITH monthly_triplets AS (
    SELECT 
        DATENAME(MONTH, s1.start_txn_time) AS reporting_month,
        MONTH(s1.start_txn_time) AS month_sort_key,
        p1.product_name AS product_1,
        p2.product_name AS product_2,
        p3.product_name AS product_3,
        COUNT(*) AS common_transaction_count,
        ROW_NUMBER() OVER(PARTITION BY MONTH(s1.start_txn_time) ORDER BY COUNT(*) DESC) AS combo_rank
    FROM sales s1
    JOIN sales s2 ON s1.txn_id = s2.txn_id AND s1.prod_id < s2.prod_id AND MONTH(s1.start_txn_time) = MONTH(s2.start_txn_time)
    JOIN sales s3 ON s1.txn_id = s3.txn_id AND s2.prod_id < s3.prod_id AND MONTH(s2.start_txn_time) = MONTH(s3.start_txn_time)
    LEFT JOIN product_details p1 ON s1.prod_id = p1.prod_id
    LEFT JOIN product_details p2 ON s2.prod_id = p2.prod_id
    LEFT JOIN product_details p3 ON s3.prod_id = p3.prod_id
    GROUP BY DATENAME(MONTH, s1.start_txn_time), MONTH(s1.start_txn_time), p1.product_name, p2.product_name, p3.product_name
)
SELECT 
    reporting_month,
    month_sort_key,
    product_1,
    product_2,
    product_3,
    common_transaction_count
INTO report_top_winning_triplet
FROM monthly_triplets
WHERE combo_rank = 1;



