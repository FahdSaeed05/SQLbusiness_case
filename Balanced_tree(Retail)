DECLARE @TargetMonth VARCHAR(20) = 'January';

-- ---------------------------------------------------------------------------------
--  STEP 2: DYNAMIC CALENDAR ROUTING ENGINE (Lines 7-30)
-- ---------------------------------------------------------------------------------
DECLARE @TargetMonthNumber INT = CASE 
    WHEN @TargetMonth = 'January'  THEN 1
    WHEN @TargetMonth = 'February' THEN 2
    WHEN @TargetMonth = 'March'    THEN 3
    ELSE 1
END;

DECLARE @TotalGlobalTxns FLOAT;

-- Pulls the target month's denominator directly using integer matching
SELECT @TotalGlobalTxns = COUNT(DISTINCT txn_id) 
FROM sales 
WHERE DATEPART(MONTH, start_txn_time) = @TargetMonthNumber;
